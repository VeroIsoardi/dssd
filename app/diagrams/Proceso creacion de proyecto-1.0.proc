          <connectors xmi:type="process:Connector" xmi:id="_PWLeAMUVEfCjD4X6f-hjTQ" documentation="Invitación a las organizaciones a crear compromisos para poder cumplir el proyecto" name="Nuevo proyecto" definitionId="email" event="ON_FINISH" ignoreErrors="true" definitionVersion="1.3.0">
